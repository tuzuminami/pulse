{
  "name": "@tuzuminami/pulse",
  "version": "1.0.0",
  "description": "Standalone conversational AI evaluation harness with redacted traces, baselines, and CI-friendly regression checks.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "license": "Apache-2.0",
  "private": false,
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/src",
    "examples/suite.public-demo.json",
    "openapi/openapi.yaml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "package.json"
  ],
  "bin": {
    "pulse": "dist/src/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "prepack": "pnpm run build && pnpm run check:private-boundary",
    "test": "node --test dist/tests/*.test.js",
    "check": "pnpm run build && pnpm run test && pnpm run check:private-boundary && pnpm run pack:dry-run",
    "check:veil-contract": "node scripts/check-veil-contract.mjs",
    "check:private-boundary": "node scripts/check-private-boundary.mjs",
    "pack:dry-run": "npm pack --dry-run --cache /tmp/pulse-npm-cache"
  },
  "devDependencies": {
    "@types/node": "24.0.10",
    "typescript": "5.9.2"
  }
}
